(ns aquaculture-management.governor-test
  (:require [clojure.test :refer [deftest is testing]]
            [aquaculture-management.store :as store]
            [aquaculture-management.governor :as governor]
            [aquaculture-management.operations :as operations]))

(defn- fresh-store []
  (let [st (store/mem-store)]
    (store/register-site! st {:site-id "site-1" :name "Acme Aquaculture" :verified? true})
    st))

(deftest ok-on-clean-harvest-schedule
  (let [st (fresh-store)
        proposal {:op :schedule-harvest :effect :propose :confidence 0.9 :stake :low}
        v (governor/check {:site-id "site-1"} {} proposal st)]
    (is (:ok? v))
    (is (not (:hard? v)))
    (is (not (:escalate? v)))))

(deftest hard-on-unregistered-site
  (let [st (fresh-store)
        proposal {:op :schedule-harvest :effect :propose :confidence 0.9 :stake :low}
        v (governor/check {:site-id "no-such-site"} {} proposal st)]
    (is (:hard? v))
    (is (some #(= :no-site (:rule %)) (:violations v)))))

(deftest hard-on-unverified-site
  (let [st (store/mem-store)
        _ (store/register-site! st {:site-id "site-2" :name "Unverified Facility" :verified? false})
        proposal {:op :schedule-harvest :effect :propose :confidence 0.9 :stake :low}
        v (governor/check {:site-id "site-2"} {} proposal st)]
    (is (:hard? v))
    (is (some #(= :no-site (:rule %)) (:violations v)))))

(deftest hard-on-no-actuation-violation
  (let [st (fresh-store)
        proposal {:op :schedule-harvest :effect :direct-write :confidence 0.9 :stake :low}
        v (governor/check {:site-id "site-1"} {} proposal st)]
    (is (:hard? v))
    (is (some #(= :no-actuation (:rule %)) (:violations v)))))

(deftest escalates-on-stock-anomaly-flag
  (let [st (fresh-store)
        proposal {:op :flag-stock-anomaly :effect :propose :confidence 0.9 :stake :high}
        v (governor/check {:site-id "site-1"} {} proposal st)]
    (is (:escalate? v))
    (is (not (:hard? v)))))

(deftest escalates-on-high-cost-supply-order
  (let [st (fresh-store)
        proposal {:op :order-supplies :effect :propose :confidence 0.9 :stake :medium}
        v (governor/check {:site-id "site-1" :cost 7500} {} proposal st)]
    (is (:escalate? v))
    (is (not (:hard? v)))))

(deftest ok-on-low-cost-supply-order
  (let [st (fresh-store)
        proposal {:op :order-supplies :effect :propose :confidence 0.9 :stake :low}
        v (governor/check {:site-id "site-1" :cost 1000} {} proposal st)]
    (is (:ok? v))
    (is (not (:hard? v)))
    (is (not (:escalate? v)))))

(deftest escalates-on-low-confidence
  (let [st (fresh-store)
        proposal {:op :log-yield-report :effect :propose :confidence 0.2 :stake :low}
        v (governor/check {:site-id "site-1"} {} proposal st)]
    (is (:escalate? v))
    (is (not (:hard? v)))))

(deftest store-records-and-ledger-append-only
  (let [st (fresh-store)]
    (store/commit-record! st {:site-id "site-1" :op :schedule-harvest})
    (store/append-ledger! st {:disposition :commit})
    (is (= 1 (count (store/records-of st "site-1"))))
    (is (= 1 (count (store/ledger st))))))

(deftest hard-on-op-outside-the-catalog
  ;; A registered, verified facility, :propose effect, high confidence: every
  ;; rule the governor had before aquaculture-management.operations is
  ;; satisfied, and this verdict was {:ok? true}.
  (let [v (governor/check {:site-id "site-1"} {}
                          {:op :apply-therapeutant :effect :propose :confidence 0.9 :stake :low}
                          (fresh-store))]
    (is (:hard? v))
    (is (not (:ok? v)))
    (is (not (:escalate? v)))
    (is (= [:unknown-op] (mapv :rule (:violations v))))))

(deftest hard-on-unreadable-llm-reply
  ;; advisor/parse-proposal's fallback. It used to escalate on its 0.0
  ;; confidence, asking a human to approve a record whose :op is :unknown.
  (let [v (governor/check {:site-id "site-1"} {}
                          {:op :unknown :effect :propose :confidence 0.0 :stake :high
                           :rationale "LLM response parse failure"}
                          (fresh-store))]
    (is (:hard? v))
    (is (not (:escalate? v)))
    (is (= [:unknown-op] (mapv :rule (:violations v))))))

(deftest every-permitted-op-passes-the-hard-rules
  ;; The catalog and the governor must agree: an op the catalog permits is
  ;; never hard-blocked for being unknown.
  (let [st (fresh-store)]
    (doseq [op (keys operations/permitted)]
      (let [v (governor/check {:site-id "site-1"} {}
                              {:op op :effect :propose :confidence 0.9 :stake :low} st)]
        (is (not (:hard? v)) (str op " was hard-blocked"))))))

(deftest catalog-is-the-advisors-documented-vocabulary
  ;; aquaculture-management.advisor's docstring names these four ops. An op
  ;; dropped from the catalog would otherwise just start holding, and nothing
  ;; above fails.
  (is (= #{:schedule-harvest :log-yield-report :order-supplies :flag-stock-anomaly}
         (set (keys operations/permitted)))))
